<UserControl x:Class="AulaStudio.Views.KnobView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="30,24,30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <CheckBox x:Name="EnabledSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Content="Knob actions on" VerticalAlignment="Center" Click="Enabled_Click" />
            <TextBlock Text="Knob" Style="{StaticResource H1}" />
        </DockPanel>
        <TextBlock Grid.Row="1" Style="{StaticResource Hint}" Margin="0,8,0,14" MaxWidth="940" HorizontalAlignment="Left"
                   Text="Your F75's knob sends volume up/down. AULA Studio turns that into scrolling, zooming or shortcuts in the app you're working in, and leaves it as volume everywhere else. Like a mouse wheel, scrolling happens wherever your mouse pointer is, so keep it over the timeline. Keep the knob in volume mode (holding it down switches it to backlight brightness, which Windows can't see)." />

        <Border x:Name="ManualBanner" Grid.Row="2" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                CornerRadius="12" Padding="16,10" Margin="0,0,0,14" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Back to automatic" Padding="12,6" Click="BackToAutomatic_Click" />
                <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock x:Name="ManualText" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardPanel}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="4,2,4,10"
                               Text="Settings for each app. The one for the app you're working in is used automatically; picking one here just lets you edit it." />
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource Ghost}" Margin="0,8,0,0" Click="AddApp_Click" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" />
                            <TextBlock Text="Add an app" />
                        </StackPanel>
                    </Button>
                    <ListBox x:Name="ProfileList" SelectionChanged="Profile_Selected" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardPanel}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Editor" Margin="22,20,22,20" />
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="{StaticResource Panel}" CornerRadius="12" Padding="16,11" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock x:Name="ActivityText" Foreground="{StaticResource Dim}" Text="Turn the knob in any app to test it. What it did, and in which app, shows up here." />
            </StackPanel>
        </Border>

        <Popup x:Name="AddPopup" StaysOpen="False" Placement="MousePoint" AllowsTransparency="True">
            <Border Background="#2A2C36" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="12" Padding="10" Width="320">
                <StackPanel>
                    <TextBlock Text="Apps that are open right now" Style="{StaticResource Hint}" Margin="4,0,0,8" />
                    <ListBox x:Name="RunningApps" MaxHeight="340" SelectionChanged="RunningApp_Selected" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
