<UserControl x:Class="AulaStudio.Views.BackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="30,24,30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource Ghost}" Click="OpenFolder_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" />
                        <TextBlock Text="Open folder" />
                    </StackPanel>
                </Button>
                <Button x:Name="BackupNowButton" Style="{StaticResource Primary}" Margin="10,0,0,0" Click="BackupNow_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" />
                        <TextBlock Text="Back up now" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="Backups" Style="{StaticResource H1}" />
        </DockPanel>
        <TextBlock Grid.Row="1" Style="{StaticResource Hint}" Margin="0,8,0,16" MaxWidth="900" HorizontalAlignment="Left"
                   Text="AULA Studio saves a full copy of the keyboard's memory before every change, and checks every change after writing it. The one marked Original is how your F75 was before AULA Studio touched it; it is never deleted. Restoring puts every key back exactly as it was in that backup." />

        <Border Grid.Row="2" Style="{StaticResource CardPanel}" Padding="12">
            <ListBox x:Name="BackupList" />
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardPanel}" Margin="0,16,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Repair Fn key" Click="RepairFn_Click" />
                    <Button Content="Repair Win key" Margin="10,0,0,0" Click="RepairWin_Click" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Quick repairs" Style="{StaticResource H2}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Hint}" Text="If Fn shortcuts or the Windows key ever stop working (for example after another app wrote to the keyboard), these put just that key back." />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
