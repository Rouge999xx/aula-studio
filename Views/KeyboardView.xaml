<UserControl x:Class="AulaStudio.Views.KeyboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="30,24,30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="250" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="PendingText" Foreground="{StaticResource Warn}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <Button x:Name="UndoButton" Style="{StaticResource Ghost}" Click="Undo_Click" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" />
                        <TextBlock Text="Undo changes" />
                    </StackPanel>
                </Button>
                <Button x:Name="SaveButton" Style="{StaticResource Primary}" Click="Save_Click" IsEnabled="False" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" />
                        <TextBlock x:Name="SaveText" Text="Save to keyboard" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Keyboard" Style="{StaticResource H1}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Margin="26,6,0,0">
                    <RadioButton x:Name="BaseTab" Style="{StaticResource Segment}" Content="Base layer" IsChecked="True" Checked="Layer_Checked" />
                    <RadioButton x:Name="FnTab" Style="{StaticResource Segment}" Content="Fn layer (hold Fn)" Checked="Layer_Checked" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource CardPanel}" Margin="0,16,0,16" Padding="22,18">
            <Grid>
                <Viewbox Stretch="Uniform">
                    <!-- Grayscale text stays crisp when the Viewbox scales the drawing. -->
                    <Canvas x:Name="KeyCanvas" Width="660" Height="290" TextOptions.TextRenderingMode="Grayscale" />
                </Viewbox>
                <Border x:Name="Disconnected" Background="#E61D1F26" CornerRadius="12" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                        <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="34" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" />
                        <TextBlock Text="Plug in your F75 with its USB cable" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock x:Name="DisconnectedDetail" Style="{StaticResource Hint}" TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardPanel}" MinHeight="250">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="SlotText" DockPanel.Dock="Right" Foreground="{StaticResource Faint}" FontSize="11.5" VerticalAlignment="Center" />
                        <TextBlock x:Name="KeyTitle" Text="Click a key to change what it does" FontSize="17" FontWeight="SemiBold" />
                    </DockPanel>
                    <TextBlock x:Name="KeySubtitle" Style="{StaticResource Hint}" Margin="0,4,0,14" />

                    <StackPanel x:Name="EditorBody" Visibility="Collapsed">
                        <WrapPanel>
                            <RadioButton x:Name="TabKey" Style="{StaticResource Segment}" Content="Key" GroupName="EditorTab" IsChecked="True" Checked="EditorTab_Checked" />
                            <RadioButton x:Name="TabShortcut" Style="{StaticResource Segment}" Content="Shortcut" GroupName="EditorTab" Checked="EditorTab_Checked" />
                            <RadioButton x:Name="TabMedia" Style="{StaticResource Segment}" Content="Media" GroupName="EditorTab" Checked="EditorTab_Checked" />
                            <RadioButton x:Name="TabOff" Style="{StaticResource Segment}" Content="Off" GroupName="EditorTab" Checked="EditorTab_Checked" />
                            <RadioButton x:Name="TabOriginal" Style="{StaticResource Segment}" Content="Original" GroupName="EditorTab" Checked="EditorTab_Checked" />
                        </WrapPanel>

                        <StackPanel x:Name="PanelKey" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CaptureButton" Click="Capture_Click" MinWidth="170">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" />
                                        <TextBlock x:Name="CaptureText" Text="Press a key to use it" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="or pick one" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="14,0" />
                                <ComboBox x:Name="KeyChoice" Width="230" SelectionChanged="KeyChoice_Changed" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="PanelShortcut" Margin="0,10,0,0" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="ModCtrl" Style="{StaticResource Chip}" Content="Ctrl" />
                                <ToggleButton x:Name="ModShift" Style="{StaticResource Chip}" Content="Shift" />
                                <ToggleButton x:Name="ModAlt" Style="{StaticResource Chip}" Content="Alt" />
                                <ToggleButton x:Name="ModWin" Style="{StaticResource Chip}" Content="Win" />
                                <TextBlock Text="+" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="6,0,12,0" FontSize="16" />
                                <ComboBox x:Name="ShortcutKey" Width="190" />
                                <Button Content="Use this shortcut" Margin="12,0,0,0" Click="UseShortcut_Click" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="Handy for editing: e.g. Ctrl+Shift+Z, or Ctrl+K to cut in Premiere Pro. The keyboard sends the whole shortcut from one key." />
                        </StackPanel>

                        <WrapPanel x:Name="PanelMedia" Margin="0,10,0,0" Visibility="Collapsed" />

                        <StackPanel x:Name="PanelOff" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Hint}" Text="The key will do nothing at all, handy for keys you hit by accident." Margin="0,0,0,10" />
                            <Button Content="Turn this key off" HorizontalAlignment="Left" Click="TurnOff_Click" />
                        </StackPanel>

                        <StackPanel x:Name="PanelOriginal" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="OriginalText" Style="{StaticResource Hint}" Margin="0,0,0,10" />
                            <Button Content="Reset to original" HorizontalAlignment="Left" Click="ResetOriginal_Click" />
                        </StackPanel>
                    </StackPanel>

                    <Border x:Name="LockedBox" Background="#1AFFB454" CornerRadius="10" Padding="14,10" Visibility="Collapsed">
                        <TextBlock x:Name="LockedText" Foreground="{StaticResource Warn}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock Text="Key tester" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Hint}" Text="With this window in front, press keys to see exactly what the keyboard sends. Use it to check a key after saving." />
                    <WrapPanel x:Name="TesterChips" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
