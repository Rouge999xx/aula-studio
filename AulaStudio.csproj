<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon); everything else is WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AulaStudio</AssemblyName>
    <RootNamespace>AulaStudio</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003 suggests WinForms' own DPI API, but this is a WPF app: WPF takes per-monitor DPI awareness from the manifest. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <Version>1.0.0</Version>
    <Product>AULA Studio</Product>
    <Description>Configurator for the AULA F75 keyboard</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is referenced for the tray icon only; keep its names out of the global namespace
         so they don't clash with WPF's (Application, Button, Color, ...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
